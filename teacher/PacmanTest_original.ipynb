    "from Pacman import Koordinaten, Direction, Position, Field\n",
    "\n",
    "field = Field(15)\n",
    "# print(field)\n",
    "for i in range(100):\n",
    "    print(\" \")\n",
    "    for pacman in field.pacmans:\n",
    "        if pacman.alive:\n",
    "            pacman.TurnOrMoveOrStill()\n",
    "    print(field)\n",
    "\n"
